{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skills Manager",
  "version": "1.0.0",
  "identifier": "com.oubuild.skillsmanager",
  "build": {
    "frontendDist": "../static",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "python3 server.py",
    "beforeBuildCommand": "pnpm build:css"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Skills Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {}
}
