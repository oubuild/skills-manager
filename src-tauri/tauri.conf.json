{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skills Manager",
  "version": "1.2.0",
  "identifier": "com.oubuild.skillsmanager",
  "build": {
    "frontendDist": "../static",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "python3 server.py",
    "beforeBuildCommand": "pnpm build:css && pnpm build:ota"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Skills Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1RjY3MjgwQzI5RjlGOEIKUldTTG41L0NnSEwyeFhDMVRNZmk1UVJuOHM5Y1E0M29tSXdBWURIT2pFVEttUStDN0YvOXB0SzQK",
      "endpoints": [
        "https://gh-proxy.com/https://github.com/oubuild/skills-manager/releases/latest/download/latest.json",
        "https://github.com/oubuild/skills-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
